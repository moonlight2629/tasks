// ---------- тест ----------
function checkQuiz(quizId, scoreId){
  const quiz=document.getElementById(quizId);
  const qs=quiz.querySelectorAll('.q');
  let correct=0, answered=0;
  qs.forEach(q=>{
    const ans=q.dataset.answer;
    const labels=q.querySelectorAll('label');
    const chosen=q.querySelector('input:checked');
    labels.forEach(l=>l.classList.remove('right','wrong'));
    q.classList.add('done');
    if(chosen){
      answered++;
      const lbl=chosen.closest('label');
      if(chosen.value===ans){correct++; lbl.classList.add('right');}
      else{
        lbl.classList.add('wrong');
        labels.forEach(l=>{ if(l.querySelector('input').value===ans) l.classList.add('right'); });
      }
    }else{
      labels.forEach(l=>{ if(l.querySelector('input').value===ans) l.classList.add('right'); });
    }
  });
  const total=qs.length;
  const res=document.getElementById(quizId+'-res');
  let text=`${correct} из ${total}`;
  if(answered<total) text+=` (не отвечено: ${total-answered})`;
  let cls='low';
  const share=correct/total;
  if(share>=0.85){cls='good'; text+=' — отлично';}
  else if(share>=0.6){cls='mid'; text+=' — хорошо, посмотри объяснения';}
  else{text+=' — вернись к теме и попробуй ещё раз';}
  res.className='result '+cls;
  res.textContent=text;
  document.getElementById(scoreId).textContent=`${correct}/${total}`;
}
function resetQuiz(quizId, scoreId){
  const quiz=document.getElementById(quizId);
  quiz.querySelectorAll('input[type=radio]').forEach(i=>i.checked=false);
  quiz.querySelectorAll('.q').forEach(q=>q.classList.remove('done'));
  quiz.querySelectorAll('label').forEach(l=>l.classList.remove('right','wrong'));
  document.getElementById(quizId+'-res').textContent='';
  document.getElementById(scoreId).textContent='—';
}

