      const sel=document.createElement('select');
      sel.setAttribute('aria-label','Выбери вариант');
      const o0=document.createElement('option'); o0.value=''; o0.textContent='выбери…'; sel.appendChild(o0);
      opts.forEach(o=>{const op=document.createElement('option'); op.value=o; op.textContent=o; sel.appendChild(op);});
      item.appendChild(sel);
    });
  });
}
function checkSort(id){
  const sort=document.getElementById(id);
  const items=sort.querySelectorAll('[data-answer]');
  let correct=0, empty=0;
  items.forEach(item=>{
    const sel=item.querySelector('select');
    item.classList.remove('right','wrong');
    if(!sel.value){empty++; return;}
    if(sel.value===item.dataset.answer){correct++; item.classList.add('right');}
    else item.classList.add('wrong');
  });
  const res=document.getElementById(id+'-res');
  let text=`${correct} из ${items.length}`;
  if(empty) text+=` (не выбрано: ${empty})`;
  res.className='result '+(correct===items.length?'good':(correct/items.length>=0.6?'mid':'low'));
  res.textContent=text;
}

// ---------- режим учителя ----------
function toggleTeacher(){
  const on=document.body.classList.toggle('teacher');
  document.getElementById('teachBtn').textContent='Режим учителя: '+(on?'вкл':'выкл');
  document.querySelectorAll('details').forEach(d=>d.open=on);
  document.querySelectorAll('.q').forEach(q=>{
    q.querySelectorAll('label').forEach(l=>{
      const isAns=l.querySelector('input').value===q.dataset.answer;
      l.classList.toggle('answer', on&&isAns);
    });
  });
}

